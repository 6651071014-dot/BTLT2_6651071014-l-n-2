<!DOCTYPE html>
<html>
<head>
    <title>Đăng ký du lịch</title>

    <style>
        body {
            font-family: Arial;
        }

        h1 {
            text-align: center;
            color: blue;
        }
        table {
            width: 800px;
            margin: auto;
            border-collapse: collapse;
            background-color: #ffffcc;
        }
        td {
            border: 1px solid #669999;
            padding: 7px;
        }
        .cot1 {
            width: 180px;
        }
        .thongbao {
            text-align: center;
            color: orange;
            font-weight: bold;
        }
        .dongy {
            text-align: center;
        }
    </style>
</head>

<body>
    <h1>Đăng ký du lịch</h1>
    <table>
        <tr>
            <td class="cot1">Họ và tên</td>
            <td>
                <input type="text" size="50">
            </td>
        </tr>
        <tr>
            <td>Địa chỉ</td>
            <td>
                <input type="text" size="35">
            </td>
        </tr>
        <tr>
            <td>Điện thoại</td>
            <td>
                <input type="text" size="25">
            </td>
        </tr>
        <tr>
            <td>Khách Việt Nam</td>
            <td>
                <input type="checkbox">
            </td>
        </tr>
        <tr>
            <td>Chọn tour</td>
            <td>
                <select>
                    <option>Buôn mê thuột - Gia lai - Kontum</option>
                    <option>Đà Lạt</option>
                    <option>Vũng Tàu</option>
                    <option>Nha Trang</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>Phương tiện</td>
            <td>
                <input type="radio" name="phuongtien">
                Máy bay

                <input type="radio" name="phuongtien" checked>
                Xe ô tô
            </td>
        </tr>
        <tr>
            <td>Số lượng đoàn khách</td>
            <td>
                <fieldset>
                    <legend>Số lượng đoàn khách</legend>

                    Người lớn
                    <input type="number" value="6" min="0">

                    Trẻ em
                    <input type="number" value="4" min="0">
                </fieldset>
            </td>
        </tr>
        <tr>
            <td>Ghi chú thêm</td>
            <td>
                <textarea rows="3" cols="50"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" class="dongy">
                <input type="button" value="Đồng ý">
            </td>
        </tr>
        <tr>
            <td colspan="2" class="thongbao">
                Bạn đã đăng ký thành công!!!
            </td>
        </tr>
    </table>
</body>
</html>
